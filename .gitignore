# Per-model venvs — only track requirements.txt, ignore the installed venv contents
src/envs/*/bin/
src/envs/*/lib/
src/envs/*/lib64/
src/envs/*/include/
src/envs/*/share/
src/envs/*/.venv/
src/envs/*/pyvenv.cfg

# Local runtime data — never commit trained voices, generated audio, downloaded models or credentials
src/voices/
src/results/
src/models/
HF_TOKEN.txt
temp/
